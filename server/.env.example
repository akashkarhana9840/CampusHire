# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
# Example: mongodb://localhost:27017/campushire OR mongodb+srv://<user>:<password>@cluster0.mongodb.net/campushire?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campushire

# JWT Secret & Expiry (Provide your own strong random secret in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
VERCEL_URL=https://campushire-frontend.vercel.app

# Default Placement Officer Credentials (for initial bootstrapping)
OFFICER_NAME=Placement Officer
OFFICER_EMAIL=officer@campushire.edu
OFFICER_PASSWORD=Officer@2026Secure

